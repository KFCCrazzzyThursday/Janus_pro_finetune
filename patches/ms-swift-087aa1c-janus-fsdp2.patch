+@contextmanager
+def _manual_fsdp2_root_context(model: nn.Module):
+    """Materialize an FSDP2 root group for a direct submodel operation.
+
+    The Transformers rollout engine calls a multimodal template's
+    ``pre_forward_hook`` directly, before ``generate``.  This bypasses the root
+    FSDP2 forward pre-hook that normally all-gathers root-owned parameters such
+    as Janus' vision tower, aligner, token embeddings, final norm, and LM head.
+    Janus also delegates ``generate`` to its language submodel, which bypasses
+    the same root hook. Temporarily unshard the root around each such direct
+    operation so regular tensors do not meet sharded DTensors.
+    """
+    is_fsdp2 = isinstance(model, FSDPModule)
+    if is_fsdp2:
+        # FSDP2 decides which state is the root from the first FSDP-wrapped
+        # module that runs forward.  Janus generation delegates directly to
+        # ``language_model``; without initializing the actual root first, an
+        # inner transformer block can incorrectly declare itself the root and
+        # the next regular training forward then fails.  There is currently no
+        # public API for this initialization, so use the same pinned PyTorch
+        # state hook that the root pre-forward invokes.
+        model._get_fsdp_state()._lazy_init()
+        model.unshard()
+    try:
+        yield
+    finally:
+        if is_fsdp2:
+            model.reshard()
+
+
